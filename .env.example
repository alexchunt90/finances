# Copy to .env and fill in. .env is git-ignored.
# Nothing is required today — the app is entirely local and manual.

# Port for the local server (default 4174).
# PORT=4174

# Interface to bind. Defaults to 0.0.0.0, which makes the app reachable from
# other devices on your network. There is no authentication, so anyone who can
# reach the port has full read and write access. Set this to restrict it to
# this machine only.
# HOST=127.0.0.1

# FRED API key for the live 30-year average on the Mortgage tab.
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Optional: JSON object of request headers for an "http" source.
# HOME_VALUE_HEADERS={"Authorization":"Bearer ..."}
