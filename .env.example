# Copy to .env and fill in. .env is git-ignored.
# Nothing is required today — the app is entirely local and manual.

# Port for the local server (default 4174).
# PORT=4174

# Interface to bind. Defaults to 0.0.0.0, which makes the app reachable from
# other devices on your network. There is no authentication, so anyone who can
# reach the port has full read and write access. Set this to restrict it to
# this machine only.
# HOST=127.0.0.1

# FRED API key for the live 30-year average on the Mortgage tab.
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Optional: JSON object of request headers for an "http" source.
# HOME_VALUE_HEADERS={"Authorization":"Bearer ..."}

# --- Shared state in an S3 bucket -------------------------------------------
#
# Unset, the app keeps its state in files under STATE_DIR. Name a bucket and it
# keeps them there instead, which is what lets several instances share one
# source of truth: every write is conditional on the version it read, so an
# instance whose copy has gone stale is refused rather than allowed to
# overwrite whoever got there first.
#
# The bucket holds nothing but the four documents. Keep it private — there is
# no authentication in front of it or in front of the app.
# S3_BUCKET=
# S3_PREFIX=finances
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Only for an S3-compatible store that is not AWS — Cloudflare R2, MinIO. Set
# it and requests go path-style to that host instead of to AWS.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- Market quotes -----------------------------------------------------------
#
# The Investments tab and the tickers widget read Yahoo Finance's chart
# endpoint, which needs no key. Nothing to set. QUOTES_URL exists for the test
# suite, which points it at a stub so the tests never touch the network.
# QUOTES_URL=
