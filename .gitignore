# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Editor / OS cruft
.DS_Store
*.sublime-workspace

# Atomic-write leftovers
*.tmp

# Documents for Claude's reference
*.pdf

# Runtime state when running in a container. STATE_DIR points here, the
# container writes it as uid 1000, and git must never own these files —
# a checkout that the container can write is a checkout git cannot update.
state/

# Your money. The app writes these; the repo must never carry them, which is
# what lets this be a public repository. The leading slash matters: it pins
# each pattern to the root so the stubs in example/ stay tracked.
#
# A fresh checkout has neither, and the server seeds both from example/ on
# first run. Point S3_BUCKET at a bucket to keep them somewhere else entirely.
/config.json
/data/
